# Run npm run backend:setup to select a managed Convex cloud development project.
# The CLI writes the actual values to .env.local (which is ignored by Git).
# These commented values are examples, not a working deployment.
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
# VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# VITE_* values are public in the browser. Never put deploy keys, Bird keys,
# Better Auth secrets, or account access tokens in VITE_* variables.
